{
  "name": "fragrance-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Accord Wheel \u2014 perfume note pairings drawn as chord diagrams, on the Gourmet Data template.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "bake:data": "python3 scripts/pipeline/bake.py",
    "bake:totals": "python3 scripts/pipeline/note_totals.py",
    "bake:perfumes": "python3 scripts/pipeline/perfume_index.py",
    "bake:accords": "python3 scripts/pipeline/accord_wheel.py",
    "bake:note-match": "python3 scripts/build_note_match_seed.py && python3 scripts/compute_note_matches.py && python3 scripts/build_note_match_index.py",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:fragella": "python3 scripts/pipeline/fragella.py",
    "test:fragella": "python3 -m unittest discover -s scripts/pipeline -p test_fragella.py"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "d3-array": "3.2.4",
    "d3-chord": "3.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.8.4",
    "vite": "5.4.21"
  }
}
